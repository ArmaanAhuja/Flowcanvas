{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "noEmit": true,
    // Scripts run with Node directly (`node scripts/x.ts`), which needs the extension in their imports.
    "allowImportingTsExtensions": true,
    "lib": ["es2024", "dom"]
  },
  "include": [
    "try-it",
    "visual",
    "perf",
    "scripts",
    "playwright.config.ts",
    "playwright.visual.config.ts",
    "playwright.perf.config.ts"
  ]
}
