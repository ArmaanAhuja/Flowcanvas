{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": ["tsconfig.base.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "@flowcanvas/web#build": {
      // The app's Worker (the control plane) is deployed with these files and bundles the host's and the
      // agent's protocol from their dist/. Cloudflare's build runs only this task (pnpm build
      // --filter=@flowcanvas/web), so it builds them too (phase 1d, step 11).
      "dependsOn": [
        "^build",
        "@flowcanvas/workspace-host#build",
        "@flowcanvas/workspace-agent#build"
      ],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/package.json", "$TURBO_ROOT$/CHANGELOG.md"],
      "outputs": ["dist/**"],
      "env": ["FLOWCANVAS_COMMIT"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "@flowcanvas/control-plane#dev": {
      "dependsOn": ["@flowcanvas/web#build"],
      "cache": false,
      "persistent": true
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": ["E2E_BASE_URL", "E2E_EXPECTED_COMMIT", "CI"]
    },
    "test:docker": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": ["WORKSPACE_HOST_TEST_PRESSURE"]
    },
    "build-storybook": {
      "dependsOn": ["^build"],
      "outputs": ["storybook-static/**"]
    },
    "@flowcanvas/web#test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/package.json", "$TURBO_ROOT$/CHANGELOG.md"]
    }
  }
}
