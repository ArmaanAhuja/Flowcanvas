{
  "name": "@flowcanvas/control-plane",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config ../../wrangler.jsonc --port 8787 --var APP_ORIGIN:http://localhost:5173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "db:migrate": "tsx --env-file-if-exists=../../.dev.vars scripts/db.ts migrate",
    "db:status": "tsx --env-file-if-exists=../../.dev.vars scripts/db.ts status",
    "db:allow": "tsx --env-file-if-exists=../../.dev.vars scripts/db.ts allow"
  },
  "dependencies": {
    "@neondatabase/serverless": "catalog:",
    "hono": "catalog:"
  },
  "devDependencies": {
    "@electric-sql/pglite": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
