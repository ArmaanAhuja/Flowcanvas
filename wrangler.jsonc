{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "flowcanvas",
  // The control plane's API (Hono), mounted under /api (decisions log, 30 Oct 2026; ADR 0013).
  "main": "./services/control-plane/src/api/worker.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./apps/web/dist",
    "not_found_handling": "single-page-application",
    // Only /api/* runs the script; everything else is served straight from the static files.
    "run_worker_first": ["/api/*"],
  },
  // Request logs, including CPU time per request (free plan allowance), to watch the 10 ms CPU limit.
  "observability": {
    "enabled": true,
  },
  // The only address sign-in works on: the one registered with GitHub and Google. Branch previews have other
  // addresses, so they show "sign in on staging" (decisions log, 30 Oct 2026). `pnpm dev` overrides it.
  "vars": {
    "APP_ORIGIN": "https://flowcanvas.ahujaarmaan7777.workers.dev",
  },
  "preview_urls": true,
  "workers_dev": true,
  "send_metrics": false,
}
