{
  "name": "@flowcanvas/engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "default": "./dist/protocol.js"
    },
    "./bundle": {
      "types": "./dist/bundle-files.d.ts",
      "default": "./dist/bundle-files.js"
    }
  },
  "files": [
    "dist",
    "grammars"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsx scripts/bundle.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude '**/*.perf.test.ts'",
    "lint": "eslint .",
    "test:perf": "vitest run perf.test"
  },
  "dependencies": {
    "@flowcanvas/workspace-agent": "workspace:*",
    "tree-sitter-css": "catalog:",
    "tree-sitter-html": "catalog:",
    "tree-sitter-javascript": "catalog:",
    "tree-sitter-json": "catalog:",
    "tree-sitter-typescript": "catalog:",
    "typescript": "catalog:",
    "web-tree-sitter": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "esbuild": "catalog:",
    "eslint": "catalog:",
    "tsx": "catalog:",
    "vitest": "catalog:"
  }
}
